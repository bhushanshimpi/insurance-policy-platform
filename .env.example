NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Used by local npm scripts. Docker Compose overrides these with service hostnames.
MONGODB_URI=mongodb://127.0.0.1:27017/insurance
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
UPLOAD_DIR=./tmp/uploads
MAX_UPLOAD_BYTES=26214400
IMPORT_BATCH_SIZE=500
IMPORT_QUEUE_CONCURRENCY=1
IMPORT_JOB_ATTEMPTS=3
IMPORT_BACKOFF_MS=5000
SCHEDULE_JOB_ATTEMPTS=3
SCHEDULE_BACKOFF_MS=5000
SCHEDULE_RECOVERY_INTERVAL_MS=60000
SCHEDULE_STALE_PROCESSING_MS=120000
CPU_THRESHOLD_PERCENT=70
CPU_SAMPLE_INTERVAL_MS=5000
CPU_CONSECUTIVE_SAMPLES=3
CPU_RESTART_COOLDOWN_MS=60000
CPU_MAX_RESTARTS_PER_WINDOW=3
CPU_RESTART_WINDOW_MS=600000
CPU_RESTART_ENABLED=true
API_CONTAINER_NAME=insurance-api
DOCKER_SOCKET_PATH=/var/run/docker.sock
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
AGGREGATE_DEFAULT_LIMIT=20
AGGREGATE_MAX_LIMIT=100
POLICIES_PER_USER_LIMIT=50
SHUTDOWN_TIMEOUT_MS=15000
BODY_LIMIT=1mb
