{
  "name": "insurance-policy-platform",
  "version": "1.0.0",
  "description": "Insurance policy management platform with CSV/XLSX import, search, aggregation, scheduled messages, and CPU monitoring.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/workers/worker.main.js",
    "monitor": "node src/monitor/main.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import": "node scripts/import-file.js",
    "up": "node scripts/compose-up.js"
  },
  "dependencies": {
    "bullmq": "^5.58.5",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "luxon": "^3.7.2",
    "mongoose": "^8.19.1",
    "multer": "^1.4.5-lts.2",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.3",
    "prettier": "^3.6.2",
    "redis-memory-server": "^0.14.0",
    "supertest": "^7.1.4"
  }
}
